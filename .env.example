# Canonical public URL used by metadata, sitemap.xml, and robots.txt
NEXT_PUBLIC_APP_URL=http://localhost:3000

# PostgreSQL connection string used by Prisma and the PostgreSQL driver.
# For managed databases, copy the provider's PostgreSQL connection string here.
DATABASE_URL=postgresql://nexora:change-me@localhost:5432/nexora?schema=public

# Replace this placeholder. Generate locally with:
# PowerShell: [Convert]::ToBase64String([Security.Cryptography.RandomNumberGenerator]::GetBytes(32))
AUTH_SECRET=replace-with-a-random-secret-at-least-32-characters
